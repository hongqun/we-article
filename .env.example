# 复制为 .env，密钥仅供文章工作台服务端使用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可独立选择支持工具调用的 DeepSeek 模型。
ARTICLE_MODEL=deepseek-flash
# 深度思考默认开启；false 关闭。medium 在 DeepSeek 服务端映射为 high。
ARTICLE_THINKING_ENABLED=true
# 支持 minimal、low、medium、high、xhigh、max、ultra；仅开启思考时发送。
ARTICLE_REASONING_EFFORT=medium
# 模型响应默认使用流式传输。
ARTICLE_STREAMING=true
# 旧工作台与 /we-article 共用追踪配置；开启后记录输入、正文、模型和工具调用。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=article
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多工作区 API Key 可按需指定工作区。
LANGSMITH_WORKSPACE_ID=
# 文章工作台认证只读取本文件；请自行设置强密码和随机会话密钥。
APP_PASSWORD=
SESSION_SECRET=
# HTTPS 反向代理环境设为 true；本地 HTTP 开发保持 false。
AUTH_COOKIE_SECURE=false
# 公众号按专题 ID 配置；例如专题 jianxi 使用 WECHAT_JIANXI_*。
# 只在启用发布或公众号统计时填写，所有账号值均为本地私密配置。
WECHAT_JIANXI_APP_ID=
WECHAT_JIANXI_APP_SECRET=
WECHAT_JIANXI_DEFAULT_THUMB_MEDIA_ID=
WECHAT_JIANXI_AUTHOR=
WECHAT_JIANXI_NEED_OPEN_COMMENT=true
WECHAT_JIANXI_ONLY_FANS_CAN_COMMENT=false
WECHAT_TECH123_APP_ID=
WECHAT_TECH123_APP_SECRET=
WECHAT_TECH123_DEFAULT_THUMB_MEDIA_ID=
WECHAT_TECH123_AUTHOR=
WECHAT_TECH123_NEED_OPEN_COMMENT=true
WECHAT_TECH123_ONLY_FANS_CAN_COMMENT=false
